# Keep real credentials in the project .env, outside Git.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_CHAT_ID=-1001234567890
# Optional: reuse a known forum topic.
# TELEGRAM_THREAD_ID=123
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=high
CODEX_TG_APPROVALS_REVIEWER=user
CODEX_TG_AUTONOMOUS_TURNS=8
CODEX_TG_AUTONOMOUS_HOURS=3
CODEX_TG_PROMPT_SUFFIX=기존 지시와 승인 범위에서 진행하고, 사용자에게 한국어로 보고하세요.
